+// Replace the latitude quadrature without changing the native recurrence or FFT plan.
+extern "C"
+int cushtns_set_latitudes(shtns_cfg shtns, const double* costheta, const double* weights)
+{
+	if (!shtns || !costheta || !weights || !shtns->d_ct || (shtns->nlat & 1)) return -1;
+	const int nlat = shtns->nlat;
+	double sum = 0;
+	for (int i=0; i<nlat; i++) {
+		if (!isfinite(costheta[i]) || !isfinite(weights[i]) || fabs(costheta[i]) >= 1 || weights[i] < 0) return -1;
+		if (i && costheta[i] > costheta[i-1]) return -1;
+		if (fabs(costheta[i] + costheta[nlat-1-i]) > 1.e-12 || fabs(weights[i] - weights[nlat-1-i]) > 1.e-12) return -1;
+		sum += weights[i];
+	}
+	if (fabs(sum - 2) > 1.e-10) return -1;
+	if (cudaStreamSynchronize(shtns->comp_stream) != cudaSuccess) return -1;
+	for (int i=0; i<nlat; i++) {
+		shtns->ct[i] = costheta[i];
+		shtns->st[i] = sqrt((1-costheta[i])*(1+costheta[i]));
+		shtns->st_1[i] = 1/shtns->st[i];
+		if (i < shtns->nlat_2) shtns->wg[i] = weights[i]/shtns->wg[-1];
+	}
+	memset(shtns->tm, 0, (shtns->mmax+1)*sizeof(*shtns->tm));
+	const int n = shtns->nlat_2;
+	const int size = shtns->sizeof_real_g;
+	int err = gpu_upload_convert(shtns->d_ct, shtns->ct, n, size);
+	err += gpu_upload_convert(((char*)shtns->d_ct) + n*size, shtns->wg, n, size);
+	err += gpu_upload_convert(((char*)shtns->d_ct) + 2*n*size, shtns->st, n, size);
+	err += gpu_upload_convert(((char*)shtns->d_ct) + 3*n*size, shtns->st_1, n, size);
+	return err ? -1 : 0;
+}
